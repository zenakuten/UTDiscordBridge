[Unit]
Description=UT2004 Discord webhook relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ut2004
Group=ut2004
EnvironmentFile=-/etc/utdiscord-relay
ExecStart=/opt/utdiscord-relay/utdiscord_relay.py --emoticons /opt/utdiscord-relay/Emoticons.ini
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
